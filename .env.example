# Copy this to .env and fill that in. .env is gitignored; this file is not.
#
# NOTHING REAL GOES IN THIS FILE. On ArvanCloud the credential is part of the
# URL path, so a filled-in "example" is a published key — and once committed it
# stays in git history whether or not the file is cleaned up afterwards.
#
# run.py and probe.py read .env automatically: no `source`, no shell setup, and
# the same on Windows, macOS and Linux.

VISION_URL="https://arvancloudai.ir/gateway/models/<MODEL>/<YOUR-TOKEN>/v1"
VISION_MODEL="Gemini-3.1-Flash-Lite-Preview"
VISION_KEY=""              # leave empty if the token lives in the URL path

# Leave the TEXT_* settings empty to reuse the vision endpoint and model, which
# is what you want while all three calls run on one model.
TEXT_URL=""
TEXT_MODEL=""
TEXT_KEY=""

GATEWAY_STYLE="openai"     # run probe.py to confirm: openai | gemini
SCORING_RUNS="3"           # median-of-3; set to 1 while iterating on the prompt
